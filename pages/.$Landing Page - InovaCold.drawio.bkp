        <mxCell id="iXtO6gRYlpFMyBNtryO2-26" value="&lt;span style=&quot;color: rgb(255, 255, 255); font-family: Figtree, sans-serif; font-size: 16px;&quot;&gt;Focamos em entregar soluções que otimizam processos e facilitam a vida dos nossos clientes, elevando a sua competitividade no mercado.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=none;" vertex="1" parent="1">
